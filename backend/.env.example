API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
ELASTICSEARCH_PORT=9200
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql+asyncpg://contractors:contractors@postgres:5432/contractors
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300
CACHE_REQUEST_TIMEOUT=0.25
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=contractors-v1
ELASTICSEARCH_REQUEST_TIMEOUT=4
MAX_CANDIDATES=500
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_CACHE_DIR=/opt/fastembed-cache
SEMANTIC_SEARCH_WEIGHT=0.7
LEXICAL_SEARCH_WEIGHT=0.3

